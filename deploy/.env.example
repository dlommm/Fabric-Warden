# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=change-me
# Encrypts stored credentials (controller API keys, TOTP secrets). Back it up
# separately from the database: without it, stored credentials are unrecoverable.
WARDEN_SECRET_KEY=change-me
# Set to false only when serving plain HTTP on a trusted LAN without a TLS proxy.
WARDEN_COOKIE_SECURE=true
WARDEN_HTTP_PORT=8080
WARDEN_DEMO_CONTROLLER_ENABLED=true
# Syslog receiver (Log Management): published on localhost unless you open it to the LAN.
WARDEN_SYSLOG_BIND=127.0.0.1
WARDEN_SYSLOG_HOST_PORT=5514
# NetFlow/IPFIX collector (Traffic & Flow Analytics): set 0.0.0.0 to receive exports from your gateway.
WARDEN_FLOW_BIND=127.0.0.1
WARDEN_FLOW_HOST_PORT=2055
# Set to 1 when a TLS reverse proxy (Caddy, Traefik, NPM, nginx) in front of the web
# container sets X-Forwarded-For. Leave 0 when browsers reach the web port directly:
# then the header is whatever the browser sent and must not be trusted.
WARDEN_FORWARDED_HOPS=0
