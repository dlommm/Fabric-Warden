# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=change-me
# Encrypts stored credentials (controller API keys, TOTP secrets). Back it up
# separately from the database: without it, stored credentials are unrecoverable.
WARDEN_SECRET_KEY=change-me
# Where the database and app data live. A cache-only appdata share (or /mnt/cache/...)
# keeps PostgreSQL off the array.
APPDATA=/mnt/user/appdata/fabric-warden
# Owner of the app data: nobody:users is the Unraid default.
PUID=99
PGID=100
TZ=Etc/UTC
# false serves sign-in over plain HTTP, as when opening http://<unraid-ip>:8080 on a trusted LAN.
# Set true when Fabric Warden is reached only through an HTTPS reverse proxy.
WARDEN_COOKIE_SECURE=false
WARDEN_HTTP_PORT=8080
WARDEN_DEMO_CONTROLLER_ENABLED=true
# Syslog receiver (Log Management): set 0.0.0.0 to receive logs from your gateway and servers.
WARDEN_SYSLOG_BIND=127.0.0.1
WARDEN_SYSLOG_HOST_PORT=5514
# NetFlow/IPFIX collector (Traffic & Flow Analytics): set 0.0.0.0 to receive exports from your gateway.
WARDEN_FLOW_BIND=127.0.0.1
WARDEN_FLOW_HOST_PORT=2055
# Set to 1 when a TLS reverse proxy (Nginx Proxy Manager, SWAG, Traefik, Caddy) in front of
# Fabric Warden sets X-Forwarded-For. Leave 0 when browsers reach the web port directly.
WARDEN_FORWARDED_HOPS=0
